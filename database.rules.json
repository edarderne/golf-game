{
  "rules": {
    ".read": false,
    ".write": false,

    "golf": {
      "rooms": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null",
          "meta": {
            "holes": { ".validate": "newData.isNumber() && (newData.val() === 3 || newData.val() === 6 || newData.val() === 9)" }
          },
          "players": {
            "$uid": {
              "name": { ".validate": "newData.isString() && newData.val().length <= 20" }
            }
          }
        }
      },

      "profiles": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" }
        }
      },

      "tournaments": {
        ".read": "auth != null",
        "$day": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            "strokes": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" }
          }
        }
      }
    }
  }
}
